---
import BaseLayout from '../layouts/BaseLayout.astro';
import Separator from '../components/ui/separator.astro';

// A "now" page — what I'm focused on at this point in life.
// Convention: https://nownownow.com/about
// Keep this current. Update the date whenever the content changes.
const lastUpdated = new Date('2026-08-25');
const formattedDate = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const focus = [
  {
    title: 'Work',
    points: [
      'Leading engineering on an internal payment platform at E.ON Digital Technology.',
      'Setting the engineering standards for an expertise group, so the teams around us can ship secure software without relearning the same lessons.',
    ],
  },
  {
    title: 'Building',
    points: [
      'This website, a small self-hosted corner of the internet I keep tinkering with.',
      'Rebuilding my home server from scratch, and writing the series about it that this blog just started.',
      'Writing here more often, usually about problems that annoyed me enough to understand them properly.',
    ],
  },
  {
    title: 'Learning',
    points: [
      'Keeping up with web security research, and the steady trickle of new HTTP and browser features that quietly change what you have to defend against.',
      'Learning to incorporate AI into my work, and how to use it responsibly without producing slop.',
    ],
  },
  {
    title: 'Away from the keyboard',
    points: [
      'Reading, and trying to spend less of my life looking at screens than my job would suggest. Currently finishing "Born to Run" by Christopher McDougall. Heading next into "Ulysses" by James Joyce.',
      'Working out and running to stay fit and healthy.',
    ],
  },
];
---

<BaseLayout
  title="Now"
  description="What Robin Reinecke is focused on right now - work, learning, and side projects."
>
  <header>
    <h1 class="text-3xl font-semibold tracking-tight">
      Now<span class="text-brand">.</span>
    </h1>
    <p class="mt-2 max-w-2xl text-muted-foreground">
      A snapshot of what I'm focused on at the moment. Inspired by <a
        href="https://nownownow.com/about"
        class="link-underline text-brand">Derek Sivers'</a
      > idea of a <span class="font-medium text-foreground">/now</span> page.
    </p>
    <p class="mt-2 text-sm text-muted-foreground">Last updated {formattedDate}.</p>
  </header>

  <Separator class="my-10" />

  <div class="flex flex-col gap-8">
    {
      focus.map((block) => (
        <section>
          <h2 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">
            {block.title}
          </h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-muted-foreground">
            {block.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
