---
import { getCollection, type CollectionEntry } from 'astro:content';
import Card from '../ui/card.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const series = post.data.series;
const currentSlug = post.data.slug ?? post.id;

// All published posts in the same series, oldest first, so part numbers are stable.
const parts = series
  ? (await getCollection('blog', ({ data }) => !data.draft && data.series === series)).sort(
      (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
    )
  : [];

const currentIndex = parts.findIndex((p) => (p.data.slug ?? p.id) === currentSlug);
---

{
  series && parts.length > 0 && (
    <Card class="mb-8 p-5">
      <p class="text-sm text-muted-foreground">
        Part {currentIndex + 1} of the <span class="font-medium text-foreground">{series}</span>{' '}
        series
        {parts.length > 1 ? ` (${parts.length} so far)` : ', with more on the way'}.
      </p>
      <ol class="mt-3 flex flex-col gap-1.5">
        {parts.map((part, index) => {
          const slug = part.data.slug ?? part.id;
          const isCurrent = index === currentIndex;
          return (
            <li class="flex gap-2 text-sm">
              <span class="text-muted-foreground tabular-nums">{index + 1}.</span>
              {isCurrent ? (
                <span class="font-medium text-brand">
                  {part.data.title} <span class="text-muted-foreground">(this post)</span>
                </span>
              ) : (
                <a href={`/blog/${slug}`} class="transition-colors hover:text-brand">
                  {part.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </Card>
  )
}
